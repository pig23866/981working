rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check valid document IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Helper to validate assignment document payload
    function isValidAssignment(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.subjectId is string && data.subjectId.size() <= 64
        && data.deadline is string && data.deadline.size() <= 64
        && data.priority in ['high', 'medium', 'low']
        && data.status in ['todo', 'in_progress', 'completed', 'submitted'];
    }

    // Helper to validate audit log document payload
    function isValidAuditLog(data) {
      return data.category is string && data.category.size() <= 64
        && data.action is string && data.action.size() <= 128
        && data.details is string && data.details.size() <= 1000;
    }

    // Helper to validate user account document payload
    function isValidUser(data) {
      return data.username is string && data.username.size() >= 2 && data.username.size() <= 64
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.role in ['user', 'admin']
        && data.passwordHash is string && data.passwordHash.size() >= 10;
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isValidId(assignmentId) && (request.resource == null || isValidAssignment(request.resource.data));
    }

    // Schedule collection
    match /schedule/{courseId} {
      allow read: if true;
      allow write: if isValidId(courseId);
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isValidId(subjectId);
    }

    // Audit logs collection (日誌記錄雲端儲存)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAuditLog(request.resource.data);
      allow update: if false; // Audit logs are immutable (不可竄改)
      allow delete: if isValidId(logId);
    }

    // Users collection (帳號資料庫同步與驗證)
    match /users/{username} {
      allow read: if true;
      allow write: if isValidId(username) && (request.resource == null || isValidUser(request.resource.data));
    }

    // Assignment progress collection (個人作業獨立完成進度)
    match /assignment_progress/{progressId} {
      allow read: if true;
      allow write: if isValidId(progressId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
